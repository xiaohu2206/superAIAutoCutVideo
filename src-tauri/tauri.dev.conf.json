{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SuperAI影视剪辑",
  "version": "1.3.6",
  "identifier": "com.superautocutvideo.app",
  "build": {
    "beforeDevCommand": "cd ../frontend && npm run dev -- --strictPort",
    "devUrl": "http://127.0.0.1:1420/",
    "frontendDist": "../frontend/dist"
  },
  "bundle": {
    "active": false,
    "resources": []
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 800,
        "height": 350,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; img-src 'self' data: blob:; media-src 'self' http://127.0.0.1:* http://localhost:* data: blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "active": false
    }
  }
}
